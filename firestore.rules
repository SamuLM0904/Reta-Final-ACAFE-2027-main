  rules_version = '2';

  // Regras de segurança do banco de dados (Firestore).
  // Publique pelo Console do Firebase (Firestore → Regras) ou com: firebase deploy --only firestore:rules
  //
  // Os documentos de alunos e administradores usam o NOME DE USUÁRIO como ID:
  //   - quem se cadastrou com nome e sobrenome → "joao_silva"
  //     (o e-mail interno da conta é "joao_silva@alunos.retafinal.app")
  //   - quem se cadastrou com e-mail → o próprio e-mail, ex.: "maria@email.com"
  service cloud.firestore {
    match /databases/{banco}/documents {

      function logado() { return request.auth != null; }

      // O usuário logado é o dono do nome de usuário `usuario`?
      function eDono(usuario) {
        return logado() && (
          request.auth.token.email == usuario ||
          request.auth.token.email == usuario + '@alunos.retafinal.app'
        );
      }

      function admin() {
        return logado() && (
          exists(/databases/$(banco)/documents/admins/$(request.auth.token.email)) ||
          (request.auth.token.email.matches('.*@alunos[.]retafinal[.]app') &&
          exists(/databases/$(banco)/documents/admins/$(request.auth.token.email.split('@')[0])))
        );
      }

      // Dados de cada aluno: só o próprio aluno lê e grava.
      // O administrador lê (lista de alunos) e atualiza (resetar a memória de erros e acertos pelo Guia).
      match /alunos/{usuario} {
        allow read, write: if eDono(usuario);
        allow read, update: if admin();
      }

      // Banco de questões: alunos logados leem; só administradores gravam
      match /questoes/{id} {
        allow read: if logado();
        allow write: if admin();
      }

      // Lista de administradores: criada só pelo Console do Firebase
      match /admins/{usuario} {
        allow read: if eDono(usuario);
        allow write: if false;
      }
    }
  }
