rules_version = '2';

// Regras de segurança do banco de dados (Firestore).
// Publique pelo Console do Firebase (Firestore → Regras) ou com: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{banco}/documents {

    function logado() { return request.auth != null; }
    function admin() {
      return logado() && exists(/databases/$(banco)/documents/admins/$(request.auth.uid));
    }

    // Dados de cada aluno: só o próprio aluno lê e grava
    match /alunos/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Banco de questões: alunos logados leem; só administradores gravam
    match /questoes/{id} {
      allow read: if logado();
      allow write: if admin();
    }

    // Lista de administradores: criada só pelo Console do Firebase
    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
